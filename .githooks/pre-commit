#!/bin/sh
# GroupViz pre-commit 门禁（零依赖，husky 替代）
# 启用方式：package.json 的 "prepare" 脚本在 npm install 时自动执行
#   git config core.hooksPath .githooks
# 检查内容：
#   1. 暂存的 .ts/.tsx 文件逐个过 eslint（只查改动文件，秒级）
#   2. 全量 tsc -b（增量缓存后 ~2s，冷缓存 ~12s）
# 绕过（不推荐）：git commit --no-verify

set -e

# 用临时文件中转：sh 的命令替换会丢弃 null 字节，多文件会粘连，
# 故 -z 输出必须落盘再喂 xargs -0
LIST=$(mktemp)
trap 'rm -f "$LIST"' EXIT
git diff --cached --name-only --diff-filter=ACM -z -- '*.ts' '*.tsx' > "$LIST"

if [ -s "$LIST" ]; then
  echo "[pre-commit] eslint 暂存的 TS 文件..."
  xargs -0 ./node_modules/.bin/eslint < "$LIST"
fi

echo "[pre-commit] tsc -b 类型检查..."
./node_modules/.bin/tsc -b

echo "[pre-commit] 通过。"
