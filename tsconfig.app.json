{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strict */
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* FGVE 双包消费（TestPage 懒加载区块）：产物 d.ts 路径映射 */
    "paths": {
      "@groupviz/core": ["./dist-pkg/@groupviz/core/index.d.ts"],
      "@groupviz/react": ["./dist-pkg/@groupviz/react/package/react.d.ts"]
    }
  },
  "include": ["src"]
}
